<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KASPAR</RootNamespace>
    <Version>1.1.1</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by the source-generated COM interop in Services/Tweaks/MicrophoneVolume.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>

    <!-- Unpackaged, self-contained deployment: no MSIX, no separate WinAppSDK runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\kasparlogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Only the WindowsAppSDK components the app uses. The Microsoft.WindowsAppSDK metapackage would also pull in
         .AI, .ML, .Widgets and .Search (onnxruntime, DirectML, ...), ~50 MB the app never loads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Copy the standalone interactive tools (scripts/*.exe etc.) next to the built exe. The registry/audio tweaks
       are implemented in-process (Services/Tweaks), so nothing else under scripts/ ships. -->
  <ItemGroup>
    <None Include="..\..\scripts\*.*" CopyToOutputDirectory="PreserveNewest" Link="scripts\%(Filename)%(Extension)" />
    <None Include="..\..\scripts\LocalAccountDuringInstallation\**" CopyToOutputDirectory="PreserveNewest" Link="scripts\LocalAccountDuringInstallation\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- `dotnet publish` does not pick up the compiled XAML (*.xbf) and the app's resource index (KASPAR.pri) that the
       build writes next to KASPAR.exe. Without them WinUI fail-fasts on launch (0xc000027b in Microsoft.UI.Xaml.dll). -->
  <Target Name="IncludeXamlOutputsInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlPublishOutput Include="$(OutDir)$(TargetName).pri;$(OutDir)*.xbf" />
      <!-- This target can run more than once per publish; remove first so the items are never duplicated (NETSDK1152). -->
      <ResolvedFileToPublish Remove="@(_XamlPublishOutput)" />
      <ResolvedFileToPublish Include="@(_XamlPublishOutput)"
                             RelativePath="%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>