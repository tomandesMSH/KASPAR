<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KASPAR.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KASPAR"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0D0D0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock HorizontalAlignment="Center" FontSize="36" FontWeight="Bold" Foreground="#E8E8F0" CharacterSpacing="250">
                <Run Text="K" /><Run Text="A" Foreground="#04A2CC" /><Run Text="SPAR" />
            </TextBlock>
            <TextBlock Text="TAKE CONTROL" HorizontalAlignment="Center" FontSize="10" Foreground="#5A5A6A" CharacterSpacing="200" />
        </StackPanel>

        <StackPanel Grid.Row="1" Width="320" Margin="0,0,0,40" HorizontalAlignment="Center" Spacing="16">
            <StackPanel x:Name="StepsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Ellipse x:Name="Step0" Width="6" Height="6" Fill="#04A2CC" />
                <Ellipse x:Name="Step1" Width="6" Height="6" Fill="#1C1C20" />
                <Ellipse x:Name="Step2" Width="6" Height="6" Fill="#1C1C20" />
                <Ellipse x:Name="Step3" Width="6" Height="6" Fill="#1C1C20" />
            </StackPanel>

            <ProgressBar x:Name="Progress" Height="2" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" Foreground="#04A2CC" Background="#1C1C20" />

            <TextBlock x:Name="StatusText" Text="Initializing..." HorizontalAlignment="Center" FontSize="11" Foreground="#5A5A6A" />
        </StackPanel>

        <TextBlock x:Name="VersionText" Grid.Row="2" Text="v1.0.0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" Foreground="#5A5A6A" Opacity="0.5" />
    </Grid>
</Window>
