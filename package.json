{
  "name": "KASPAR",
  "version": "1.0.8",
  "description": "KASPAR - Take Control.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kaspar.app",
    "productName": "Kaspar",
    "win": {
      "target": "nsis",
      "icon": "files/applogo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "tomandesMSH",
      "repo": "KASPAR"
    },
    "extraResources": [
      {
        "from": "scripts/",
        "to": "scripts/"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "assets/**",
      "files/**"
    ]
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}
